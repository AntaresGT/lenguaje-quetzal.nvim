{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/doc/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": ["?.lua", "?/init.lua", "lua/?.lua", "lua/?/init.lua"]
  },
  "diagnostics": {
    "globals": ["vim"]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": ["$VIMRUNTIME/lua", "$VIMRUNTIME/lua/vim/lsp"]
  }
}
